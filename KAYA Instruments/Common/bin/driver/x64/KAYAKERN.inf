[Version]
CatalogFile               = KAYAKERN.cat
Class                     = %ClassName% 
ClassGuid                 = {30451C46-7B03-4D96-9145-7C06226965B7}
DriverPackageDisplayName  = %KAYAKERN.DRVDESC%
DriverPackageType         = PlugAndPlay
DriverVer = 02/26/2025,66.0.10774.0354
                                           ; and to $(KAYA_MAJOR_VERSION)$(KAYA_MINOR_VERSION).10$(KAYA_PATCH_VERSION).$(KAYA_SVN_REVISION_QT).%H%M in Debug mode
Provider                  = %Companyname%
Signature                 = "$WINDOWS NT$"

[DestinationDirs]
DefaultDestDir  = 12
CoInstaller_CopyFiles = 11

; ====================== Class Section ========================================
[ClassInstall32]
Addreg        = KAYAKERN.ClassReg

[KAYAKERN.ClassReg]
HKR,,,0,%ClassName%
HKR,,Icon,,-5
HKR,,DeviceCharacteristics,0x10001,0x100     ;Use same security checks on relative opens
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;WD)" ;Allow generic all access to system, built-in Admin and World

; ====================== Device Install Section ===============================
[ControlFlags]
ExcludeFromSelect = *

[Manufacturer]
%Companyname%=KAYA,NTamd64

[SourceDisksFiles]
KAYAKERN.sys    = 1
WdfCoInstaller01011.dll = 1 ; make sure the number matches with SourceDisksNames

[SourceDisksNames]
1="KAYAKERN Install Disk",

; For XP and later
[KAYA.NTamd64]
