[KAYAKERN_Inst.NT]
CopyFiles      = KAYAKERN.CopyFiles

[KAYAKERN.CopyFiles]
KAYAKERN.sys

; MSI/MSI-X support
[KAYAKERN_Inst.NT.HW]
AddReg = KAYAKERN.EnableMSI

; 24 Interrupt resources are required - 16 for user events and 8 for dma channels
[KAYAKERN.EnableMSI]
HKR,"Interrupt Management",,0x00000010
HKR,"Interrupt Management\MessageSignaledInterruptProperties",,0x00000010
HKR,"Interrupt Management\MessageSignaledInterruptProperties",MSISupported,0x00010001,1
HKR,"Interrupt Management\MessageSignaledInterruptProperties",MessageNumberLimit,0x00010001,32


[KAYAKERN_Inst.NT.Services]
AddService     = KAYAKERN,0x00000002,KAYAKERN_Service

[KAYAKERN_Service]
DisplayName    = %KAYAKERN.SVCDESC%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\KAYAKERN.sys
AddReg         = KAYAKERN_Inst.NT.Services.AddReg

[KAYAKERN_Inst.NT.Services.AddReg]
HKR,Parameters,"POLL_MODE",0x00010001,0 ; set to 1 for hardware polling, default is 0 (interrupts)

; ====================== WDF Coinstaller installation =========================

[KAYAKERN_Inst.NT.CoInstallers]
AddReg         = CoInstaller_AddReg
CopyFiles      = CoInstaller_CopyFiles

[CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller01011.dll,WdfCoInstaller"

[CoInstaller_CopyFiles]
WdfCoInstaller01011.dll

[KAYAKERN_Inst.NT.Wdf]
KmdfService    = KAYAKERN, KAYAKERN_wdfsect

[KAYAKERN_wdfsect]
KmdfLibraryVersion = 1.11

;======================= String Definitions ===================================
[Strings]
Companyname             = "KAYA Instruments Ltd."
ClassName               = "KAYA Instruments devices"
KAYAKERN.SVCDESC        = "KAYA Instruments PCI Driver Service"
KAYAKERN.DRVDESC        = "PCI Driver"
DeviceDescription       = "KAYA Instruments PCI device"
